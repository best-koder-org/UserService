{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{SourceContext}] [{X-Correlation-ID}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/user-service-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{SourceContext}] [{X-Correlation-ID}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithEnvironmentName"
        ],
        "Properties": {
            "Application": "UserService",
            "Environment": "Development"
        }
    },
    "AllowedHosts": "*",
    "Embeddings": {
        "Enabled": true,
        "BaseUrl": "http://localhost:11434/v1",
        "Model": "all-minilm:l6-v2",
        "TimeoutSeconds": 20,
        "RequireApiKey": false
    },
    "Psykolog": {
        "FreeMonthlySessionLimit": 5,
        "PremiumMonthlySessionLimit": 0,
        "FreeMessageLimit": 30,
        "PremiumMessageLimit": 60,
        "MaxSessionAgeMinutes": 360
    },
    "InternalApiSecret": "dev-internal-secret",
    "Services": {
        "MatchmakingService": "http://localhost:8083",
        "InternalApiKey": "user-service-internal-key-dev-only"
    }
}